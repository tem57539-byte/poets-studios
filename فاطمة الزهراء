<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ديوان فاطمة الزهراء</title>
<style>
  @import url('https://fonts.googleapis.com/css2?family=Amiri:wght@400;700&family=Cairo:wght@400;700;900&display=swap');
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Cairo',sans-serif;background:#F8F3E7;color:#1E2E1E}
  header{background:#1E3A2B;color:#F8F3E7;padding:20px;text-align:center;border-bottom:4px solid #C9A227;position:sticky;top:0;z-index:10}
  header h1{font-family:'Amiri',serif;font-size:38px}
  header p{color:#E8D9A0}
  nav{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:12px}
  nav button{background:#C9A227;color:#1E3A2B;border:none;padding:9px 16px;border-radius:20px;font-weight:900;cursor:pointer}
  nav button.active{background:white}
  .wrap{max-width:900px;margin:auto;padding:20px}
  .card{background:white;border-radius:18px;padding:22px;margin:15px 0;box-shadow:0 4px 20px rgba(0,0,0,.08);border:1px solid #EADFAE}
  .poem{font-family:'Amiri',serif;font-size:22px;line-height:2.1;text-align:center;white-space:pre-line}
  .gold{color:#9A7B12;font-weight:900}
  h2{font-family:'Amiri',serif;font-size:28px;margin-bottom:10px}
  input,textarea{width:100%;padding:12px;border-radius:12px;border:1px solid #ddd;margin:8px 0;font-family:'Cairo'}
  .btn{background:#1E3A2B;color:white;border:none;padding:12px 18px;border-radius:12px;font-weight:900;cursor:pointer;width:100%}
  .poet{display:flex;gap:12px;align-items:center;background:#FFF9E3;padding:12px;border-radius:14px;margin:8px 0}
  .avatar{width:55px;height:55px;border-radius:50%;background:#C9A227;display:flex;align-items:center;justify-content:center;font-size:26px}
  .quote{font-family:'Amiri',serif;font-size:21px;text-align:center}
  #chatBox{height:220px;overflow:auto;background:#F8F3E7;padding:12px;border-radius:12px;margin-bottom:10px}
  .msg{background:white;padding:8px 12px;border-radius:12px;margin:6px 0}
  .hidden{display:none}
  footer{text-align:center;padding:20px;color:#888}
</style>
</head>
<body>

<header>
  <h1>ديوان فاطمة الزهراء</h1>
  <p>حيثُ تُزهر الحروف وتُغنّي القصائد</p>
  <nav>
    <button onclick="show('home')" id="b-home" class="active">الرئيسية</button>
    <button onclick="show('diwan')" id="b-diwan">الديوان</button>
    <button onclick="show('studio')" id="b-studio">استديو الشعراء</button>
    <button onclick="show('quotes')" id="b-quotes">اقتباسات وخواطر</button>
    <button onclick="show('chat')" id="b-chat">شات المحادثة</button>
    <button onclick="show('login')" id="b-login">دخول الشعراء</button>
  </nav>
</header>

<div class="wrap">

  <!-- الرئيسية -->
  <div id="home">
    <div class="card" style="text-align:center">
      <h2>أهلاً بك في ديواني</h2>
      <p>أنا <b>فاطمة الزهراء</b>، وهذا بيتي الشعري. هنا أنشر قصائدي، وأستقبل الشعراء في استديو خاص بهم.</p>
      <br>
      <p class="quote">"العلمُ يرفعُ من أرادَ ويهتدي"</p>
      <p class="gold">— من قصيدة يا أستاذُ علِّمني</p>
    </div>
    <div class="card">
      <h2>✨ أحدث قصيدة</h2>
      <p><b>يا أستاذُ علِّمني كتابةَ دَرْسِنا</b> - بقلم فاطمة الزهراء</p>
      <button class="btn" onclick="show('diwan')">اقرأ القصيدة كاملة</button>
    </div>
  </div>

  <!-- الديوان -->
  <div id="diwan" class="hidden">
    <div class="card">
      <h2>يا أستاذُ علِّمني</h2>
      <p class="gold">بقلم: فاطمة الزهراء</p>
      <div class="poem">يا أستاذُ علِّمني كتابةَ دَرْسِنا
واجعلْ حروفَ العلمِ نورًا يُقتَدى
علِّمني كيفَ القراءةُ تُرتجى
وكيفَ أقرأُ ما كتبتَ وأهتدي
خذْ بيدي نحوَ المعارفِ إنّني
ظمآنُ علمٍ في رحابِكَ أبتدي
واجعلْ من الأقلامِ جسرًا للعلى
فالعلمُ يرفعُ من أرادَ ويهتدي
أنتَ المعلّمُ والفضائلُ كلُّها
فيكَ اجتمعتْ فكنتَ فخرَ المقتدي
غرستَ فينا من مكارمِ خُلْقِكَ
ما يستحيلُ على الزمانِ بمُبعَدِ
يا من وهبتَ العلمَ دونَ تردُّدٍ
وبذلتَ جهدَكَ للنفوسِ بلا غدِ
تبقى حروفُكَ في القلوبِ منارةً
ويظلُّ ذكركَ في الضمائرِ يُحتذى
إن كانَ للفضلِ الرفيعِ قصيدةٌ
فأنتَ في أبياتِها خيرُ المبتدأِ
فامضِ معلّمَنا فذكركَ خالدٌ
والعلمُ يشهدُ أنَّ فضلكَ لا يُحدّ.</div>
    </div>

    <div class="card">
      <h2>انشري قصيدة جديدة</h2>
      <input id="newTitle" placeholder="عنوان القصيدة">
      <textarea id="newPoem" rows="5" placeholder="اكتبي القصيدة هنا..."></textarea>
      <button class="btn" onclick="addPoem()">نشر في الديوان</button>
      <div id="myPoems"></div>
    </div>
  </div>

  <!-- الاستديو -->
  <div id="studio" class="hidden">
    <div class="card">
      <h2>استديو الشعراء</h2>
      <p>كل شاعر له صفحة خاصة به.</p>
      <div class="poet"><div class="avatar">ف</div><div><b>فاطمة الزهراء</b><br>صاحبة الديوان - 1 قصيدة</div></div>
      <div class="poet"><div class="avatar">ض</div><div><b>عمو ضياء</b><br>شاعر ضيف - صفحة خاصة</div></div>
      <div id="poetsList"></div>
    </div>
    <div class="card">
      <h2>انضم كشاعر</h2>
      <input id="poetName" placeholder="اسمك كشاعر">
      <button class="btn" onclick="addPoet()">إنشاء صفحتي</button>
    </div>
  </div>

  <!-- اقتباسات -->
  <div id="quotes" class="hidden">
    <div class="card"><p class="quote">"واجعلْ من الأقلامِ جسرًا للعلى<br>فالعلمُ يرفعُ من أرادَ ويهتدي"</p><p style="text-align:center" class="gold">- فاطمة الزهراء</p></div>
    <div class="card"><p class="quote">"تبقى حروفُكَ في القلوبِ منارةً<br>ويظلُّ ذكركَ في الضمائرِ يُحتذى"</p></div>
    <div class="card">
      <h2>اكتبي خاطرة أو اقتباس</h2>
      <textarea id="newQuote" rows="3" placeholder="اكتبي خاطرتك..."></textarea>
      <button class="btn" onclick="addQuote()">نشر الخاطرة</button>
      <div id="quotesList"></div>
    </div>
  </div>

  <!-- شات -->
  <div id="chat" class="hidden">
    <div class="card">
      <h2>شات الشعراء 💬</h2>
      <div id="chatBox"><div class="msg"><b>فاطمة:</b> أهلاً بكم في ديواني 🌹</div></div>
      <input id="chatName" placeholder="اسمك">
      <input id="chatMsg" placeholder="اكتب رسالتك...">
      <button class="btn" onclick="sendMsg()">إرسال</button>
    </div>
  </div>

  <!-- دخول -->
  <div id="login" class="hidden">
    <div class="card">
      <h2>دخول الشعراء</h2>
      <input placeholder="اسم المستخدم أو الإيميل">
      <input type="password" placeholder="كلمة السر">
      <button class="btn" onclick="alert('أهلاً بك يا شاعر! في النسخة الكاملة هيتم ربط ده بقاعدة بيانات حقيقية')">تسجيل الدخول</button>
      <p style="text-align:center;margin-top:10px">دي نسخة تجريبية شغالة على جهازك، لو عايزة تسجيل دخول حقيقي هقولك تعمليه ازاي مجاناً.</p>
    </div>
  </div>

</div>

<footer>ديوان فاطمة الزهراء © 2026 - صُنع بحب</footer>

<script>
function show(id){
  ['home','diwan','studio','quotes','chat','login'].forEach(s=>{
    document.getElementById(s).classList.add('hidden');
    document.getElementById('b-'+s).classList.remove('active');
  });
  document.getElementById(id).classList.remove('hidden');
  document.getElementById('b-'+id).classList.add('active');
}
function addPoem(){
  let t=document.getElementById('newTitle').value, p=document.getElementById('newPoem').value;
  if(!t||!p) return alert('اكتبي العنوان والقصيدة');
  document.getElementById('myPoems').innerHTML += `<div class="card"><h2>${t}</h2><div class="poem">${p}</div></div>`;
  document.getElementById('newTitle').value=''; document.getElementById('newPoem').value='';
  alert('تم نشر قصيدتك ❤️');
}
function addPoet(){
  let n=document.getElementById('poetName').value;
  if(!n) return alert('اكتب اسمك');
  document.getElementById('poetsList').innerHTML += `<div class="poet"><div class="avatar">${n[0]}</div><div><b>${n}</b><br>صفحة شاعر جديدة</div></div>`;
  alert('اتعملت صفحتك يا '+n);
}
function addQuote(){
  let q=document.getElementById('newQuote').value;
  if(!q) return;
  document.getElementById('quotesList').innerHTML += `<div class="card"><p class="quote">${q}</p></div>`;
  document.getElementById('newQuote').value='';
}
function sendMsg(){
  let n=document.getElementById('chatName').value||'ضيف', m=document.getElementById('chatMsg').value;
  if(!m) return;
  document.getElementById('chatBox').innerHTML += `<div class="msg"><b>${n}:</b> ${m}</div>`;
  document.getElementById('chatMsg').value='';
}
</script>
</body>
</html>
